  set -euo pipefail

  # shellcheck source=.container/foundation/tools.d/b19-i18n
  . b19-i18n

  B19_OFFGRID_MODE="${B19_OFFGRID_MODE:-N}"
  B19_FETCH_LOCAL_PATH="${B19_FETCH_LOCAL_PATH:-/fetch}"
  APT_LISTS_LOCAL="${B19_FETCH_LOCAL_PATH}/apt-lists"
  APT_LISTS_TARGET="/var/lib/apt/lists"

  if [ -d "${APT_LISTS_LOCAL}" ] && [ -n "$(ls -A "${APT_LISTS_LOCAL}" 2>/dev/null)" ]
  then
    b19-run "PACKAGES" "$(_p "Copy APT lists from %s" "${APT_LISTS_LOCAL}")" --  \
      flock --close /var/lib/apt/.buildkit-lock flock --close /var/cache/apt/.buildkit-lock \
      cp -rp "${APT_LISTS_LOCAL}/." "${APT_LISTS_TARGET}/"
    b19-log good "PACKAGES" "$(_ "Local APT lists applied, skipping apt-get update")"
  elif [ "${B19_OFFGRID_MODE}" = "Y" ]
  then
    b19-log good "PACKAGES" "$(_ "Offgrid mode, no local lists, skipping apt-get update")"
  else
    b19-log info "PACKAGES" "$(_p "Lock shared APT caches %s and %s" "/var/lib/apt/.buildkit-lock" "/var/cache/apt/.buildkit-lock")"

    # A mirror caught mid-rsync can serve an InRelease whose signature does not
    # yet match its own content (BADSIG), self-healing within seconds. --error-on=any
    # is meant to catch a real problem, not this — ride out the transient with
    # retries instead of loosening the check.
    apt_update_attempt() {
      # The lists dir is a cache mount shared with concurrent builds — apt cleanup would delete list files their sources do not declare.
      b19-run "PACKAGES" "$(_p "Update APT lists (attempt %s/%s)" "$1" "$2")" --  \
        flock --close /var/lib/apt/.buildkit-lock flock --close /var/cache/apt/.buildkit-lock \
        apt-get update --allow-releaseinfo-change --error-on=any --option APT::Get::List-Cleanup=false
    }

    APT_UPDATE_ATTEMPTS=3
    for attempt in $(seq 1 "${APT_UPDATE_ATTEMPTS}"); do
      if apt_update_attempt "${attempt}" "${APT_UPDATE_ATTEMPTS}"; then
        exit 0
      fi
      code=$?
      [ "${attempt}" -eq "${APT_UPDATE_ATTEMPTS}" ] && exit "${code}"
      wait_s=$(( 5 * (2 ** (attempt - 1)) + (RANDOM % 5) ))
      b19-log warn "PACKAGES" "$(_p "APT update attempt %s/%s failed (exit %s), retrying in %s s" "${attempt}" "${APT_UPDATE_ATTEMPTS}" "${code}" "${wait_s}")"
      sleep "${wait_s}"
    done
  fi
