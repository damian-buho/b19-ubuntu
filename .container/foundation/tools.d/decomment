# decomment - Strip comments from text (stdin to stdout filter)
#
# Usage: cat file.txt | decomment
#        command | decomment
#        decomment < file.txt
#
# Features:
#   - Removes full-line comments (lines starting with # followed by space/tab)
#   - Removes inline comments (everything after # not in quotes)
#   - Preserves preprocessor directives (#define, #include, etc.)
#   - Trims trailing whitespace from output lines
#   - Strips carriage returns
#   - Optimized for pipe usage in build systems

set -euo pipefail

# Process line by line from stdin
while IFS= read -r line || [ -n "$line" ]; do
    # Skip full-line comments (lines starting with # followed by space/tab/end)
    if [[ "$line" =~ ^[[:space:]]*#[[:space:]] ]]; then
        continue
    fi

    # Preserve preprocessor directives (lines starting with # followed by directive)
    if [[ "$line" =~ ^[[:space:]]*#[a-zA-Z_]+ ]]; then
        echo "$line"
        continue
    fi

    # Shield escaped hashes so the inline strip below leaves them alone
    line=${line//\\#/ESCAPED_HASH}
    # Cut at the first hash, trailing spaces go with the trim below
    line=${line%%#*}
    # Restore the shielded hashes
    line=${line//ESCAPED_HASH/#}
    # Drop every carriage return, matching the old tr -d '\r'
    line=${line//$'\r'/}
    # Trim trailing whitespace without forking sed
    while [[ "${line}" == *[[:space:]] ]]; do
        line=${line%?}
    done

    # Skip blank lines after processing
    [[ -z "${line}" ]] && continue

    # Output the processed line
    echo "$line"
done