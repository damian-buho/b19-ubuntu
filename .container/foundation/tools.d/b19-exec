# b19-exec [OPTIONS] -- COMMAND [ARGS...]: supervises a long-running command, see docs/how-to/use-b19-exec.md

# shellcheck disable=SC2329 # on_signal and its helpers run from the signal traps
set -euo pipefail

# shellcheck source=.container/foundation/tools.d/b19-i18n
. b19-i18n

STDOUT_LEVEL="${B19_EXEC_STDOUT_LEVEL:-info}"
STDERR_LEVEL="${B19_EXEC_STDERR_LEVEL:-warn}"
STDOUT_TAG=""
STDERR_TAG=""
FOREGROUND=0
BACKGROUND=0
OPTIONAL=0
NAME=""
STOP=""
PASSTHROUGH="${B19_EXEC_PASSTHROUGH:-false}"
STOP_TIMEOUT="${B19_EXEC_STOP_TIMEOUT:-30}"
STATE_PATH="${B19_RUNTIME_PATH:-/run/b19}/b19-exec"
STOP_SIGNALS=" INT QUIT TERM "

while [ $# -gt 0 ]; do
  case "$1" in
    --stdout-level)
      STDOUT_LEVEL="$2"
      shift 2
      ;;
    --stderr-level)
      STDERR_LEVEL="$2"
      shift 2
      ;;
    --stdout-tag)
      STDOUT_TAG="$2"
      shift 2
      ;;
    --stderr-tag)
      STDERR_TAG="$2"
      shift 2
      ;;
    --foreground)
      FOREGROUND=1
      shift
      ;;
    --background)
      BACKGROUND=1
      shift
      ;;
    --name)
      NAME="$2"
      shift 2
      ;;
    --optional)
      OPTIONAL=1
      shift
      ;;
    --stop)
      STOP="$2"
      shift 2
      ;;
    --passthrough)
      PASSTHROUGH=true
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      b19-log error "b19-exec" "$(_ "Unknown option:") $1"
      exit 1
      ;;
  esac
done

if [ -n "${STOP}" ] && [ $# -gt 0 ]; then
  b19-log error "b19-exec" "$(_p "%s and %s exclude each other" "--stop" "$1")"
  exit 1
fi
if [ $# -eq 0 ] && [ -z "${STOP}" ]; then
  b19-log error "b19-exec" "$(_ "No command provided. Usage: b19-exec [OPTIONS] -- COMMAND [ARGS...]")"
  exit 1
fi

for level in "${STDOUT_LEVEL}" "${STDERR_LEVEL}"; do
  case "${level}" in
    error|bad|warn|good|info|note)
      ;;
    *)
      b19-log error "b19-exec" "$(_ "Invalid log level:") ${level}. $(_ "Must be one of: error, bad, warn, good, info, note")"
      exit 1
      ;;
  esac
done

case "${PASSTHROUGH,,}" in
  true|1|yes)
    PASSTHROUGH=true
    ;;
  false|0|no|"")
    PASSTHROUGH=false
    ;;
  *)
    b19-log error "b19-exec" "$(_p "%s must be true or false, got %s" "B19_EXEC_PASSTHROUGH" "${PASSTHROUGH}")"
    exit 1
    ;;
esac

for name in "${NAME}" "${STOP}"; do
  if [ -n "${name}" ] && ! [[ "${name}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    b19-log error "b19-exec" "$(_p "Invalid name %s: use letters, digits, dot, dash and underscore" "${name}")"
    exit 1
  fi
done
if [ "${BACKGROUND}" -eq 1 ] && [ -z "${NAME}" ]; then
  b19-log error "b19-exec" "$(_p "%s needs %s" "--background" "--name")"
  exit 1
fi
if [ "${BACKGROUND}" -eq 1 ] && [ "${FOREGROUND}" -eq 1 ]; then
  b19-log error "b19-exec" "$(_p "%s and %s exclude each other" "--background" "--foreground")"
  exit 1
fi
if [ "${OPTIONAL}" -eq 1 ] && [ "${BACKGROUND}" -eq 0 ]; then
  b19-log error "b19-exec" "$(_p "%s needs %s" "--optional" "--background")"
  exit 1
fi
if ! [[ "${STOP_TIMEOUT}" =~ ^[0-9]+$ ]]; then
  b19-log error "b19-exec" "$(_p "%s must be a whole number of seconds, got %s" "B19_EXEC_STOP_TIMEOUT" "${STOP_TIMEOUT}")"
  exit 1
fi

# An explicit tag wins, then the name, then the historical stream tags
STDOUT_TAG="${STDOUT_TAG:-${NAME:-STDOUT}}"
STDERR_TAG="${STDERR_TAG:-${NAME:-STDERR}}"
ROLE=payload
[ "${BACKGROUND}" -eq 0 ] || ROLE=required
[ "${OPTIONAL}" -eq 0 ] || ROLE=optional
EXPLICIT_NAME="${NAME}"
NAME="${NAME:-payload}"

if [ -f "${B19_HOME:-/app}/.signals" ]; then
  SIGNALS=$(decomment < "${B19_HOME:-/app}/.signals") || true
else
  SIGNALS="HUP INT QUIT TERM USR1 USR2"
fi

# Routes the command output through one b19-log per stream, or straight to the container
open_loggers() {
  if [ "${PASSTHROUGH}" = true ]; then
    b19-log debug "b19-exec" "$(_p "Passthrough: %s writes to the container directly" "$1")"
    exec {STDOUT_LOG_FD}>/proc/1/fd/1
    STDOUT_LOG_PID=""
    exec {STDERR_LOG_FD}>/proc/1/fd/2
    STDERR_LOG_PID=""
  else
    # shellcheck disable=SC2086 # the signal list splits on purpose
    exec {STDOUT_LOG_FD}> >(trap '' ${SIGNALS}; exec b19-log "${STDOUT_LEVEL}" "${STDOUT_TAG}" > /proc/1/fd/1)
    STDOUT_LOG_PID=$!
    # shellcheck disable=SC2086 # the signal list splits on purpose
    exec {STDERR_LOG_FD}> >(trap '' ${SIGNALS}; exec b19-log "${STDERR_LEVEL}" "${STDERR_TAG}" > /proc/1/fd/2)
    STDERR_LOG_PID=$!
  fi
}

# Closes both pipes and waits for each logger by PID, so the last lines are never lost
close_loggers() {
  exec {STDOUT_LOG_FD}>&-
  exec {STDERR_LOG_FD}>&-
  [ -z "${STDOUT_LOG_PID}" ] || wait "${STDOUT_LOG_PID}" 2>/dev/null || true
  [ -z "${STDERR_LOG_PID}" ] || wait "${STDERR_LOG_PID}" 2>/dev/null || true
}

if [ "${FOREGROUND}" -eq 1 ]; then
  open_loggers "$1"
  "$@" < /proc/1/fd/0 1>&"${STDOUT_LOG_FD}" 2>&"${STDERR_LOG_FD}" \
    && RETURN_CODE=0 || RETURN_CODE=$?
  close_loggers
  exit "${RETURN_CODE}"
fi

# Prints field N (0 = state) after the command name of /proc/PID/stat
proc_field() {
  local _stat _fields
  { read -r _stat < "/proc/$1/stat"; } 2>/dev/null || return 1
  read -ra _fields <<<"${_stat##*) }"
  printf '%s\n' "${_fields[$2]}"
}

# Succeeds while PID is still the process that started at clock tick TICKS
alive() {
  local _ticks
  [[ "$1" =~ ^[0-9]+$ ]] || return 1
  _ticks=$(proc_field "$1" 19) || return 1
  [ -z "${2:-}" ] || [ "${_ticks}" = "$2" ]
}

# Prints every record, or only NAME's, as "name pid role ticks seq supervisor supervisor_ticks"
read_records() {
  local _file _name _pid _role _ticks _seq _sup _sup_ticks
  for _file in "${STATE_PATH}"/*.pid; do
    [ -e "${_file}" ] || continue
    _name="${_file##*/}"
    [ -z "${1:-}" ] || [ "${_name}" = "$1.pid" ] || continue
    _pid="" _role="" _ticks="" _seq="" _sup="" _sup_ticks=""
    read -r _pid _role _ticks _seq _sup _sup_ticks 2>/dev/null < "${_file}" || true
    [[ "${_pid}" =~ ^[0-9]+$ ]] || continue
    printf '%s %s %s %s %s %s %s\n' "${_name%.pid}" "${_pid}" "${_role:-required}" "${_ticks:--}" "${_seq:-0}" "${_sup:-${_pid}}" "${_sup_ticks:--}"
  done
}

# Lists the records, or only NAME's, whose process still runs, in the read_records shape
list_records() {
  local _name _pid _role _ticks _rest
  while read -r _name _pid _role _ticks _rest; do
    alive "${_pid}" "${_ticks#-}" || continue
    printf '%s %s %s %s %s\n' "${_name}" "${_pid}" "${_role}" "${_ticks}" "${_rest}"
  done < <(read_records "$@")
}

# Lists the required records whose process is gone, in the read_records shape
list_gone_required() {
  local _name _pid _role _ticks _rest
  while read -r _name _pid _role _ticks _rest; do
    [ "${_role}" = required ] || continue
    ! alive "${_pid}" "${_ticks#-}" || continue
    printf '%s %s %s %s %s\n' "${_name}" "${_pid}" "${_role}" "${_ticks}" "${_rest}"
  done < <(read_records)
}

# Holds a stop until every command claimed after ours is gone, so stops run newest first
wait_newer() {
  local _deadline _name _pid _role _ticks _seq _waiting _logged=""
  [ -n "${CMD_SEQ}" ] || return 0
  _deadline=$(( SECONDS + STOP_TIMEOUT ))
  while :; do
    _waiting=""
    while read -r _name _pid _role _ticks _seq _; do
      [ "${_name}" != "${NAME}" ] || continue
      [ "${_seq}" -le "${CMD_SEQ}" ] || _waiting="${_waiting:+${_waiting} }${_name}"
    done < <(list_records)
    [ -n "${_waiting}" ] || return 0
    if [ "${SECONDS}" -ge "${_deadline}" ]; then
      b19-log warn "b19-exec" "$(_p "Stopping %s after %ss although %s still runs" "${NAME}" "${STOP_TIMEOUT}" "${_waiting}")"
      return 0
    fi
    if [ "${_logged}" != "${_waiting}" ]; then
      b19-log info "b19-exec" "$(_p "%s stops after %s" "${NAME}" "${_waiting}")"
      _logged="${_waiting}"
    fi
    sleep 0.1
  done
}

# Forwards SIGNAL to the command's process group; a stop waits for newer commands and is sent once
on_signal() {
  local _signal="$1"
  if [ -z "${CMD_PID}" ]; then
    if [[ "${STOP_SIGNALS}" == *" ${_signal} "* ]]; then
      b19-log info "b19-exec" "$(_p "%s received %s before it started, it will not start" "${NAME}" "${_signal}")"
      STOPPING=1
      PENDING="${_signal}"
    else
      b19-log debug "b19-exec" "$(_p "%s has not started, %s dropped" "${NAME}" "${_signal}")"
    fi
    return 0
  fi
  if [[ "${STOP_SIGNALS}" == *" ${_signal} "* ]]; then
    if [ "${STOPPING}" -eq 1 ]; then
      b19-log debug "b19-exec" "$(_p "%s is already stopping, %s not forwarded again" "${NAME}" "${_signal}")"
      return 0
    fi
    STOPPING=1
    if [ -e "${STATE_PATH}/${NAME}.stop" ]; then
      b19-log debug "b19-exec" "$(_p "%s stops on request, without waiting for newer commands" "${NAME}")"
    else
      wait_newer
    fi
  fi
  b19-log info "b19-exec" "$(_p "Forwarding %s to %s (pid %s)" "${_signal}" "${NAME}" "${CMD_PID}")"
  kill -s "${_signal}" -- "-${CMD_PID}" 2>/dev/null \
    || b19-log debug "b19-exec" "$(_p "%s (pid %s) is already gone" "${NAME}" "${CMD_PID}")"
}

# Writes FILE atomically with CONTENT
write_state() {
  printf '%s\n' "$2" > "$1.$$"
  mv --force "$1.$$" "$1"
}

# Claims NAME and the next start sequence under the state lock, recording the supervisor as the not yet started command
claim_name() {
  local _lock _pid _ticks
  exec {_lock}>/dev/null
  if [ "${TRACKED}" -eq 1 ]; then
    exec {_lock}>"${STATE_PATH}/.lock"
    b19-log debug "b19-exec" "$(_p "Waiting for lock on %s" "${STATE_PATH}/.lock")"
    flock "${_lock}"
    _pid=""
    read -r _ _pid _ _ticks _ < <(list_records "${NAME}") || true
    if [ -n "${_pid}" ]; then
      if [ -n "${EXPLICIT_NAME}" ]; then
        b19-log error "b19-exec" "$(_p "%s is already running (pid %s)" "${NAME}" "${_pid}")"
        exec {_lock}>&-
        return 1
      fi
      b19-log warn "b19-exec" "$(_p "%s is already running (pid %s), this one runs untracked" "${NAME}" "${_pid}")"
      TRACKED=0
    fi
  fi
  if [ "${TRACKED}" -eq 1 ]; then
    CMD_SEQ=0
    read -r CMD_SEQ 2>/dev/null < "${STATE_PATH}/.seq" || true
    [[ "${CMD_SEQ}" =~ ^[0-9]+$ ]] || CMD_SEQ=0
    CMD_SEQ=$(( CMD_SEQ + 1 ))
    write_state "${STATE_PATH}/.seq" "${CMD_SEQ}"
    SUPERVISOR_TICKS=$(proc_field "${SUPERVISOR}" 19) || SUPERVISOR_TICKS="-"
    rm -f "${STATE_PATH}/${NAME}.exit" "${STATE_PATH}/${NAME}.stop"
    write_state "${STATE_PATH}/${NAME}.pid" "${SUPERVISOR} ${ROLE} ${SUPERVISOR_TICKS} ${CMD_SEQ} ${SUPERVISOR} ${SUPERVISOR_TICKS}"
    b19-log debug "b19-exec" "$(_p "Claimed %s (supervisor pid %s, sequence %s)" "${NAME}" "${SUPERVISOR}" "${CMD_SEQ}")"
  fi
  exec {_lock}>&-
}

# Starts the command in its own session and records it
start_command() {
  local _stdin=/proc/1/fd/0
  [ "${ROLE}" = payload ] || _stdin=/dev/null
  setsid "$@" < "${_stdin}" 1>&"${STDOUT_LOG_FD}" 2>&"${STDERR_LOG_FD}" &
  CMD_PID=$!
  CMD_TICKS=$(proc_field "${CMD_PID}" 19) || CMD_TICKS="-"
  if [ "${TRACKED}" -eq 1 ]; then
    write_state "${STATE_PATH}/${NAME}.pid" "${CMD_PID} ${ROLE} ${CMD_TICKS} ${CMD_SEQ} ${SUPERVISOR} ${SUPERVISOR_TICKS}"
    b19-log debug "b19-exec" "$(_p "Recorded %s (pid %s, %s)" "${NAME}" "${CMD_PID}" "${ROLE}")"
  fi
}

# Drops our record when it still names our command
forget_command() {
  local _pid _role
  [ "${TRACKED}" -eq 1 ] || return 0
  read -r _pid _role 2>/dev/null < "${STATE_PATH}/${NAME}.pid" || return 0
  [ "${_pid}" != "${CMD_PID:-${SUPERVISOR}}" ] || rm -f "${STATE_PATH}/${NAME}.pid" "${STATE_PATH}/${NAME}.stop"
}

# Prints the exit code a failed required daemon left, waiting until its supervisor wrote it or is gone
failed_code() {
  local _code="" _sup="" _sup_ticks=""
  while :; do
    read -r _code 2>/dev/null < "${STATE_PATH}/$1.exit" && [ -n "${_code}" ] && break
    _sup=""
    read -r _ _ _ _ _ _sup _sup_ticks < <(read_records "$1") || true
    if [ -z "${_sup}" ] || ! alive "${_sup}" "${_sup_ticks#-}" || [ "$(proc_field "${_sup}" 0)" = Z ]; then
      read -r _code 2>/dev/null < "${STATE_PATH}/$1.exit" || true
      break
    fi
    sleep 0.1
  done
  [ -n "${_code}" ] || b19-log warn "b19-exec" "$(_p "No exit code recorded for %s, its supervisor %s is gone" "$1" "${_sup:-?}")"
  printf '%s\n' "${_code:-1}"
}

# Stops the payload because required NAME exited, keeping its exit code
fail_fast() {
  FAILED="$1"
  FAILED_CODE=$(failed_code "${FAILED}")
  b19-log error "b19-exec" "$(_p "Stopping %s: required %s exited with %s" "${NAME}" "${FAILED}" "${FAILED_CODE}")"
  kill -s TERM -- "-${CMD_PID}" 2>/dev/null || true
}

# Prints the names of NAME:SUPERVISOR:TICKS entries whose supervisor has not exited yet
running_supervisors() {
  local _entry _name _sup _ticks
  for _entry in "$@"; do
    IFS=: read -r _name _sup _ticks <<<"${_entry}"
    alive "${_sup}" "${_ticks#-}" && [ "$(proc_field "${_sup}" 0)" != Z ] && printf '%s\n' "${_name}"
  done
  return 0
}

# Stops every other recorded command, or only NAME, through its supervisor and waits until they and their supervisors are gone
stop_others() {
  local _name _pid _role _left _deadline _logged="" _supervisor _sup_ticks
  local -a _supervisors=()
  while read -r _name _pid _role _ _ _supervisor _sup_ticks; do
    if [ -n "${1:-}" ]; then
      b19-log info "b19-exec" "$(_p "Stopping %s (pid %s)" "${_name}" "${_pid}")"
    elif [ "${_role}" = payload ]; then
      continue
    else
      b19-log info "b19-exec" "$(_p "Stopping %s (pid %s) after %s" "${_name}" "${_pid}" "${NAME}")"
    fi
    _supervisors+=("${_name}:${_supervisor}:${_sup_ticks}")
    { alive "${_supervisor}" "${_sup_ticks#-}" && kill -s TERM "${_supervisor}" 2>/dev/null; } \
      || b19-log debug "b19-exec" "$(_p "%s (pid %s) is already gone" "${_name}" "${_pid}")"
  done < <(list_records "$@")
  _deadline=$(( SECONDS + STOP_TIMEOUT ))
  while _left=$({ list_records "$@" | cut --delimiter=' ' --fields=1; running_supervisors "${_supervisors[@]}"; } | sort --unique | paste --serial --delimiters=' ') && [ -n "${_left}" ]; do
    if [ "${SECONDS}" -ge "${_deadline}" ]; then
      b19-log warn "b19-exec" "$(_p "Leaving after %ss although %s still runs" "${STOP_TIMEOUT}" "${_left}")"
      return 1
    fi
    if [ "${_logged}" != "${_left}" ]; then
      b19-log debug "b19-exec" "$(_p "Waiting for %s to stop" "${_left}")"
      _logged="${_left}"
    fi
    sleep 0.1
  done
}

# Runs the command until it exits, forwarding signals; the payload also fails fast on a required daemon
supervise() {
  local _done _code _name _pid _role _watcher _signal _gone
  local -A _watchers=()
  STOPPING=0
  PENDING=""
  FAILED=""
  CMD_PID=""
  CMD_TICKS="-"
  CMD_SEQ=""
  SUPERVISOR_TICKS="-"
  # BASHPID read inside a $(…) would name that substitution's subshell
  SUPERVISOR="${BASHPID}"
  TRACKED=1
  if ! mkdir -p "${STATE_PATH}" 2>/dev/null || ! [ -w "${STATE_PATH}" ]; then
    b19-log warn "b19-exec" "$(_p "Cannot write %s as uid %s, %s runs untracked" "${STATE_PATH}" "$(id --user)" "${NAME}")"
    TRACKED=0
  fi
  for _signal in ${SIGNALS}; do
    # shellcheck disable=SC2064 # bound per signal
    trap "on_signal ${_signal}" "${_signal}"
  done
  open_loggers "$1"

  if [ "${ROLE}" = payload ] && [ "${TRACKED}" -eq 1 ]; then
    for _done in "${STATE_PATH}"/*.exit; do
      [ -e "${_done}" ] || continue
      _name="${_done##*/}"
      FAILED="${_name%.exit}"
      RETURN_CODE=$(failed_code "${FAILED}")
      b19-log error "b19-exec" "$(_p "Not starting %s: required %s exited with %s" "${NAME}" "${FAILED}" "${RETURN_CODE}")"
      stop_others || true
      close_loggers
      exit "$(( RETURN_CODE == 0 ? 1 : RETURN_CODE ))"
    done
  fi

  claim_name || { close_loggers; exit 1; }
  if [ -n "${PENDING}" ]; then
    forget_command
    close_loggers
    exit "$(( 128 + $(kill -l "${PENDING}") ))"
  fi
  start_command "$@"
  if [ -n "${PENDING}" ]; then
    b19-log info "b19-exec" "$(_p "Forwarding held %s to %s (pid %s)" "${PENDING}" "${NAME}" "${CMD_PID}")"
    kill -s "${PENDING}" -- "-${CMD_PID}" 2>/dev/null || true
  fi

  if [ "${ROLE}" = payload ] && [ "${TRACKED}" -eq 1 ]; then
    _gone=""
    while read -r _name _pid _role _; do
      [ "${_role}" = required ] || continue
      # shellcheck disable=SC2086 # the signal list splits on purpose
      ( trap '' ${SIGNALS}; exec tail --pid="${_pid}" --follow /dev/null ) &
      _watchers[$!]="${_name}"
      b19-log debug "b19-exec" "$(_p "%s fails fast when %s (pid %s) exits" "${NAME}" "${_name}" "${_pid}")"
    done < <(list_records)
    while read -r _name _pid _role _; do
      b19-log debug "b19-exec" "$(_p "Required %s (pid %s) is already gone" "${_name}" "${_pid}")"
      _gone="${_gone:-${_name}}"
    done < <(list_gone_required)
    # A daemon whose record vanished before the scans above left its exit code behind
    for _done in "${STATE_PATH}"/*.exit; do
      [ -e "${_done}" ] || continue
      _name="${_done##*/}"
      _gone="${_gone:-${_name%.exit}}"
    done
    [ -z "${_gone}" ] || fail_fast "${_gone}"
  fi

  while :; do
    _done=""
    wait -n -p _done "${CMD_PID}" "${!_watchers[@]}" 2>/dev/null && _code=0 || _code=$?
    # Bash 5.2 reaps a child that exits during a trap, so wait -n names no PID: collect it by hand
    if [ -z "${_done:-}" ] && ! [ -e "/proc/${CMD_PID}" ]; then
      _done="${CMD_PID}"
      wait "${CMD_PID}" 2>/dev/null && _code=0 || _code=$?
    fi
    for _watcher in "${!_watchers[@]}"; do
      [ -z "${_done:-}" ] || break
      [ -e "/proc/${_watcher}" ] || _done="${_watcher}"
    done
    if [ -z "${_done:-}" ]; then
      b19-log debug "b19-exec" "$(_p "Wait for %s interrupted with %s" "${NAME}" "${_code}")"
      continue
    fi
    if [ "${_done}" = "${CMD_PID}" ]; then
      RETURN_CODE="${_code}"
      break
    fi
    _name="${_watchers[${_done}]}"
    unset "_watchers[${_done}]"
    if [ "${STOPPING}" -eq 1 ] || [ -n "${FAILED}" ]; then
      b19-log debug "b19-exec" "$(_p "%s exited while %s stops" "${_name}" "${NAME}")"
      continue
    fi
    fail_fast "${_name}"
  done

  for _watcher in "${!_watchers[@]}"; do
    kill -s KILL "${_watcher}" 2>/dev/null || true
    wait "${_watcher}" 2>/dev/null || true
  done

  if [ "${ROLE}" = payload ]; then
    b19-log debug "b19-exec" "$(_p "%s (pid %s) exited with %s" "${NAME}" "${CMD_PID}" "${RETURN_CODE}")"
    forget_command
    [ "${TRACKED}" -eq 0 ] || stop_others || true
    if [ -n "${FAILED}" ]; then
      RETURN_CODE="$(( FAILED_CODE == 0 ? 1 : FAILED_CODE ))"
    fi
  elif [ "${STOPPING}" -eq 1 ]; then
    b19-log info "b19-exec" "$(_p "%s (pid %s) stopped with %s" "${NAME}" "${CMD_PID}" "${RETURN_CODE}")"
  elif [ "${ROLE}" = optional ]; then
    b19-log warn "b19-exec" "$(_p "Optional %s (pid %s) exited with %s, the container keeps running" "${NAME}" "${CMD_PID}" "${RETURN_CODE}")"
  else
    [ "${TRACKED}" -eq 0 ] || write_state "${STATE_PATH}/${NAME}.exit" "${RETURN_CODE}"
    b19-log error "b19-exec" "$(_p "Required %s (pid %s) exited with %s" "${NAME}" "${CMD_PID}" "${RETURN_CODE}")"
  fi
  forget_command

  close_loggers
  exit "${RETURN_CODE}"
}

if [ -n "${STOP}" ]; then
  if [ -z "$(list_records "${STOP}")" ]; then
    b19-log info "b19-exec" "$(_p "%s is not running" "${STOP}")"
    exit 3
  fi
  write_state "${STATE_PATH}/${STOP}.stop" "$$" 2>/dev/null \
    || b19-log warn "b19-exec" "$(_p "Cannot write %s, %s stops after the commands started later" "${STATE_PATH}/${STOP}.stop" "${STOP}")"
  stop_others "${STOP}" || exit 1
  b19-log info "b19-exec" "$(_p "Stopped %s" "${STOP}")"
  exit 0
fi

if [ "${BACKGROUND}" -eq 0 ]; then
  supervise "$@"
fi

( supervise "$@" ) < /dev/null > /proc/1/fd/1 2> /proc/1/fd/2 &
SUPERVISOR_PID=$!
# an unwritable state dir never gets a record, so there is nothing to wait for
if ! mkdir -p "${STATE_PATH}" 2>/dev/null || ! [ -w "${STATE_PATH}" ]; then
  b19-log info "b19-exec" "$(_p "Started %s untracked (supervisor pid %s)" "${NAME}" "${SUPERVISOR_PID}")"
  exit 0
fi
while [ -e "/proc/${SUPERVISOR_PID}" ] && [ "$(proc_field "${SUPERVISOR_PID}" 0 2>/dev/null)" != Z ]; do
  if read -r DAEMON_PID _ _ _ RECORD_SUPERVISOR _ 2>/dev/null < "${STATE_PATH}/${NAME}.pid" \
    && [ "${RECORD_SUPERVISOR}" = "${SUPERVISOR_PID}" ] && [ "${DAEMON_PID}" != "${SUPERVISOR_PID}" ]; then
    b19-log info "b19-exec" "$(_p "Started %s (pid %s, %s)" "${NAME}" "${DAEMON_PID}" "${ROLE}")"
    exit 0
  fi
  sleep 0.05
done
wait "${SUPERVISOR_PID}" && RETURN_CODE=0 || RETURN_CODE=$?
