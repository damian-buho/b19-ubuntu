  set -euo pipefail

    # shellcheck source=.container/foundation/tools.d/b19-i18n
    . b19-i18n
    [ "${NO_COLOR:-0}" = "1" ] && B19_COLOR=0
    [ "${M6E_AI:-N}" = "Y" ] && B19_COLOR=0
    case "${B19_COLOR:-1}" in
        auto)  [ -t 2 ] && _USE_COLOR=1 || _USE_COLOR=0 ;;
        1)     _USE_COLOR=1 ;;
        0|'')  _USE_COLOR=0 ;;
        *)     _USE_COLOR=0 ;;
    esac

    LEVEL=$1
    shift
    TAG=$1
    shift

    # Set up input: fd 3 streams from stdin or from arguments
    PIPE_MODE=0
    if [ $# -eq 0 ]; then
        exec 3<&0
        PIPE_MODE=1
    else
        exec 3< <(printf "%b" "$*")
    fi

    # Map B19_VERBOSITY to numeric threshold (default: warn = 30)
    case "${B19_VERBOSITY:-warn}" in
      "error")
        LEVEL_THRESHOLD=40
        ;;
      "warn")
        LEVEL_THRESHOLD=30
        ;;
      "info")
        LEVEL_THRESHOLD=20
        ;;
      "debug")
        LEVEL_THRESHOLD=10
        ;;
      *)
        # Invalid level: default to warn, no error message to avoid recursion
        LEVEL_THRESHOLD=30
        ;;
    esac

    # Map current message level to priority
    case "${LEVEL}" in
      "error")
        LEVEL_PRIORITY=40
        ;;
      "warn")
        LEVEL_PRIORITY=30
        ;;
      "bad"|"good"|"info")
        LEVEL_PRIORITY=20
        ;;
      "debug"|"note")
        LEVEL_PRIORITY=10
        ;;
      *)
        # Unknown level: preserve existing error behavior
        # shellcheck disable=SC2005
        echo "$(_p "Unknown log level: %s. Valid: error, warn, info, debug" "${LEVEL}")" >&2
        exit 1
        ;;
    esac

    # Early exit if message priority is below threshold
    # Skip filtering in pipe mode to avoid SIGPIPE / silent output loss
    if [ "${PIPE_MODE}" -eq 0 ] && [ "${LEVEL_PRIORITY}" -lt "${LEVEL_THRESHOLD}" ]; then
      exit 0
    fi

    # Escape $2 as a JSON string body into the variable named $1
    json_string() {
        local -n _json_out=$1
        local _json_in=$2 _json_char _json_index _json_escaped=""
        _json_in=${_json_in//\\/\\\\}
        _json_in=${_json_in//\"/\\\"}
        _json_in=${_json_in//$'\t'/\\t}
        _json_in=${_json_in//$'\r'/\\r}
        if [[ ${_json_in} == *[$'\x01'-$'\x1f']* ]]; then
            for (( _json_index = 0; _json_index < ${#_json_in}; _json_index++ )); do
                _json_char=${_json_in:_json_index:1}
                [[ ${_json_char} == [$'\x01'-$'\x1f'] ]] && printf -v _json_char '\\u%04x' "'${_json_char}"
                _json_escaped+=${_json_char}
            done
            _json_in=${_json_escaped}
        fi
        _json_out=${_json_in}
    }

    # One JSON object per line; a payload line that already is one passes unchanged
    if [ "${B19_LOG_FORMAT:-text}" = "json" ]; then
        TZ=UTC
        JSON_TAG="" JSON_MSG=""
        case "${LEVEL}" in
          "bad"|"good") JSON_LEVEL=info ;;
          "note") JSON_LEVEL=debug ;;
          *) JSON_LEVEL=${LEVEL} ;;
        esac
        json_string JSON_TAG "${TAG}"
        JSON_STAGE=""
        if [ -n "${STAGE:-}" ]; then
            json_string JSON_STAGE "${STAGE}"
            JSON_STAGE="\"stage\":\"${JSON_STAGE}\","
        fi
        while IFS= read -r line || [ -n "$line" ]; do
          if [ "${PIPE_MODE}" -eq 1 ] && [[ ${line} == \{*\} ]]; then
            printf '%s\n' "${line}" >&2
            continue
          fi
          json_string JSON_MSG "${line}"
          # Locale-proof epoch: digits only, the last six are microseconds
          JSON_EPOCH=${EPOCHREALTIME//[!0-9]/}
          printf -v JSON_TIME '%(%Y-%m-%dT%H:%M:%S)T' "${JSON_EPOCH:0:-6}"
          printf '{"time":"%s.%sZ","level":"%s",%s"tag":"%s","msg":"%s"}\n' \
            "${JSON_TIME}" "${JSON_EPOCH: -6:3}" "${JSON_LEVEL}" "${JSON_STAGE}" "${JSON_TAG}" "${JSON_MSG}" >&2
        done <&3
        exit 0
    fi

    # Suppress ANSI colors when color is disabled
    if [ "${_USE_COLOR}" = "0" ]; then
        COLOR=""
    else
        # Original color mapping (now only runs for messages that pass filter)
        case "${LEVEL}" in
          "good")
            COLOR="--green"
            ;;
          "bad")
            COLOR="--yellow"
            ;;
          "error")
            COLOR="--red"
            ;;
          "warn")
            COLOR="--yellow"
            ;;
          "note")
            COLOR="--blue"
            ;;
          "debug")
            COLOR="--black-intense"
            ;;
          "info")
            COLOR="--black-intense"
            ;;
          *)
            # shellcheck disable=SC2005
            echo "$(_p "Unknown log level: %s. Valid: error, warn, info, debug" "${LEVEL}")"
            exit 1
            ;;
        esac
    fi

    # Split LOG by newlines and process each line
    # The printf "%b" expands literal \n to real newlines
    if [ "${_USE_COLOR}" = "0" ]; then
        # No color: plain text output. The colored path encodes the LEVEL as the
        # message colour, which a captured log drops on the floor — so print it as
        # a column here instead. That is the only thing that makes a warn/error
        # findable in reports/*.log (m6e-run greps ^WARN to quote it under a green
        # pointer). Payload passthrough (PIPE_MODE) keeps the bare shape: those
        # lines are the process's own output, not a b19 log record.
        while IFS= read -r line || [ -n "$line" ]; do
          if [ -n "${STAGE:-}" ]; then
            printf " %s " "${STAGE^^}" >&2
          fi
          if [ "${PIPE_MODE}" -eq 0 ]; then
            printf " %-5s " "${LEVEL^^}" >&2
          fi
          printf " %-12s " "${TAG^^}" >&2
          printf " %s\n" "${line}" >&2
        done <&3
    else
        # warn/info/debug: colored output
        while IFS= read -r line || [ -n "$line" ]; do
          if [ -n "${STAGE:-}" ]; then
            ansi -n --black --bg-white " ${STAGE^^} " >&2
          fi
          ansi -n --black --bg-black-intense " $(printf "%-12s" "${TAG^^}") " >&2
          ansi "${COLOR}" " ${line}" >&2
        done <&3
    fi