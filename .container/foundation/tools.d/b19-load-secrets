# b19-load-secrets - Load secrets from /run/secrets/ into environment variables
#
# Usage: . b19-load-secrets (must be sourced, not executed)
#
# Scans /run/secrets/*.* files, converts dot notation to env vars:
#   npm.registry_host       -> NPM_REGISTRY_HOST
#   b19.npm.registry_host   -> B19_NPM_REGISTRY_HOST
#
# Environment variables take precedence (won't overwrite existing vars)
# Set B19_SECRETS_ENABLED=false to skip loading

  # shellcheck source=.container/foundation/tools.d/b19-i18n
  . b19-i18n

  if [ "${B19_SECRETS_ENABLED:-}" = "false" ]; then
    b19-log info "SECRETS" "$(_ "Secrets loading disabled")"
    # shellcheck disable=SC2317
    return 0 2>/dev/null || true
  fi

  _ls_loaded=0
  _ls_skipped=0
  _ls_dir="${B19_SECRETS_PATH:-/run/secrets}"

  if [ ! -d "${_ls_dir}" ]; then
    if [ -n "${B19_REQUIRED_SECRETS:-}" ]; then
      b19-log info "SECRETS" "$(_ "No secrets directory found")"
    fi
    unset _ls_loaded _ls_skipped _ls_dir
    # shellcheck disable=SC2317
    return 0 2>/dev/null || true
  fi

  for _ls_file in "${_ls_dir}"/*.*; do
    [ -e "${_ls_file}" ] || continue

    _ls_name=$(basename "${_ls_file}")
    _ls_var=$(echo "${_ls_name}" | tr '-' '_' | tr '.' '_' | tr '[:lower:]' '[:upper:]')

    if [ -n "${!_ls_var:-}" ]; then
      b19-log info "SECRETS" "$(_ "Skipping") ${_ls_name} (${_ls_var} $(_ "already set"))"
      _ls_skipped=$((_ls_skipped + 1))
      continue
    fi

    # Binary/non-UTF-8 secrets (keys, DER blobs, gzipped tarballs) cannot live in
    # an env var: bash truncates at the first NUL, and the stray bytes panic any
    # consumer that iterates the environment as UTF-8 (e.g. minijinja --env, used
    # by j2-render to template configs). Such secrets are meant to be read from
    # the file path, so we skip the export and leave the file at /run/secrets/.
    if ! iconv -f UTF-8 -t UTF-8 "${_ls_file}" >/dev/null 2>&1; then
      b19-log warn "SECRETS" "$(_p "Skipping binary secret %s (non-UTF-8; read it from %s instead of the env var)" "${_ls_name}" "${_ls_file}")"
      _ls_skipped=$((_ls_skipped + 1))
      continue
    fi

    _ls_value=$(cat "${_ls_file}" | tr -d '\n')
    export "${_ls_var}=${_ls_value}"
    b19-log good "SECRETS" "$(_ "Loaded") ${_ls_name} -> ${_ls_var}"
    _ls_loaded=$((_ls_loaded + 1))
  done

  if [ ${_ls_loaded} -gt 0 ] || [ ${_ls_skipped} -gt 0 ]; then
    b19-log info "SECRETS" "$(_ "Summary:") ${_ls_loaded} $(_ "loaded,") ${_ls_skipped} $(_ "skipped")"
  fi

  unset _ls_loaded _ls_skipped _ls_dir _ls_file _ls_name _ls_var _ls_value
