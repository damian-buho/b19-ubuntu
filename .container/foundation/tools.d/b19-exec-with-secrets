# b19-exec-with-secrets - Source secrets, then exec a command.
#
# Wrapper for non-entrypoint code paths (notably `docker exec`) where the
# image's static ENV is the only environment available — runtime exports from
# entrypoint.d/ are invisible, and shell.d/ only fires for interactive bash.
# This is shell-agnostic on the caller side: it loads secrets, then replaces
# itself with the target command via exec, so the wrapper disappears from the
# process tree.
#
# Usage:
#   b19-exec-with-secrets COMMAND [ARGS...]
#
# Examples:
#   docker exec CONTAINER b19-exec-with-secrets npm run pump
#   docker exec CONTAINER b19-exec-with-secrets payload generate:types
#
# Note: stdout/stderr/TTY pass through normally. Unlike b19-exec, this does
# NOT route output through b19-log to PID 1 — that is intentional, callers
# of `docker exec` want their command's output on their terminal.

set -euo pipefail

# shellcheck source=.container/foundation/tools.d/b19-i18n
. b19-i18n

if [ $# -eq 0 ]; then
  b19-log error "b19-exec-with-secrets" "$(_ "No command provided. Usage: b19-exec-with-secrets COMMAND [ARGS...]")"
  exit 1
fi

# shellcheck source=.container/foundation/tools.d/b19-load-secrets
. b19-load-secrets

exec "$@"
